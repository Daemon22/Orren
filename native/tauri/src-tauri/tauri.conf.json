{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orren",
  "version": "0.1.0",
  "identifier": "com.orren.engine",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Orren",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi", "nsis"],
    "icon": []
  }
}
