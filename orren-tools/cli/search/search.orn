-- orren_tools.cli.search
-- Search the Orren package registry for modules and libraries.
-- Supports field-specific search, sorting, pagination, and caching.

module orren_tools.cli.search

import orren.core.language.foundation::{String, Int, Float, Bool, List, Map}
import orren.core.language.foundation::{Result, Ok, Err, Option, Some, None}
import orren.core.language.foundation::{DateTime, Duration, Timer}
import orren.core.net::{HttpClient, HttpRequest, HttpResponse, StatusCode}
import orren.core.json::{JsonParser, JsonValue}

intent "Search the Orren package registry for modules, libraries, and dependencies"

-- Enumerates which package field the search query targets.
enum SearchField
  NAME
  DESCRIPTION
  AUTHOR
  TAG
  DEPENDENCY
end

-- Enumerates available sort orders for search results.
enum SortBy
  RELEVANCE
  NAME
  DATE
  DOWNLOADS
  DEPENDENTS
end

-- A single search result entry returned by the registry.
entity SearchResult
  property name: String = ""
  property version: String = ""
  property description: String = ""
  property author: String = ""
  property downloads: Int = 0
  property tags: List<String> = []
  property last_updated: String = ""
  property dependencies_count: Int = 0
  property score: Float = 0.0
end

-- Configuration that controls search behaviour, filters, and pagination.
entity SearchConfig
  property field: SearchField = SearchField.NAME
  property sort_by: SortBy = SortBy.RELEVANCE
  property max_results: Int = 20
  property offset: Int = 0
  property tags_filter: List<String> = []
  property min_downloads: Int = 0
end

-- Aggregated response from a search operation.
entity SearchResponse
  property results: List<SearchResult> = []
  property total: Int = 0
  property query: String = ""
  property search_time: String = ""
end

-- The main search engine that queries remote registries and caches responses.
entity PackageSearcher
  property config: SearchConfig = SearchConfig{}
  property registries: List<String> = ["https://registry.orren-lang.org"]
  property cache: Map<String, SearchResponse> = {}
end

-- ── Formatting helpers ─────────────────────────────────────────────────

-- Format a single SearchResult into a human-readable table row.
fn format_result(self, result: SearchResult) -> String
  let dl_str be result.downloads.to_string()
  let dep_str be result.dependencies_count.to_string()
  let score_str be (result.score * 100.0).to_int().to_string() + "%"
  let line be result.name + " " + result.version + "  " + result.description
  let meta be "  [" + dl_str + " downloads, " + dep_str + " deps, score " + score_str + "]"
  return line + meta
end

-- Format the full SearchResponse into a table suitable for terminal display.
fn format_response(self, response: SearchResponse) -> String
  let lines be List<String>[]
  lines.append("Search results for: \"" + response.query + "\"")
  lines.append("Total matches: " + response.total.to_string())
  lines.append("Search time: " + response.search_time)
  lines.append("─────────────────────────────────────────────────────────────")
  for result in response.results do
    lines.append(self.format_result(result))
  end
  if response.results.length == 0 then
    lines.append("No packages found matching your query.")
  end
  lines.append("─────────────────────────────────────────────────────────────")
  let output be String.join("\n", lines)
  return output
end

-- ── Cache management ────────────────────────────────────────────────────

-- Build a deterministic cache key from the query and config.
fn cache_key(self, query: String) -> String
  let field_str be match self.config.field with
    case SearchField.NAME do "name" end
    case SearchField.DESCRIPTION do "desc" end
    case SearchField.AUTHOR do "author" end
    case SearchField.TAG do "tag" end
    case SearchField.DEPENDENCY do "dep" end
    end
  let sort_str be match self.config.sort_by with
    case SortBy.RELEVANCE do "rel" end
    case SortBy.NAME do "name" end
    case SortBy.DATE do "date" end
    case SortBy.DOWNLOADS do "dl" end
    case SortBy.DEPENDENTS do "depc" end
    end
  return query + "|" + field_str + "|" + sort_str + "|" + self.config.max_results.to_string()
end

-- Look up a cached response.  Returns None on cache miss.
fn get_cached(self, query: String) -> Option<SearchResponse>
  let key be self.cache_key(query)
  if self.cache.has(key) then
    return Some(self.cache.get(key))
  end
  return None
end

-- Store a response in the cache for future lookups.
fn put_cached(self, query: String, response: SearchResponse) -> Unit
  let key be self.cache_key(query)
  self.cache.put(key, response)
  return Unit{}
end

-- ── Remote registry queries ─────────────────────────────────────────────

-- Build the query URL parameters for the registry API.
fn build_query_url(self, base_url: String, query: String) -> String
  let field_param be match self.config.field with
    case SearchField.NAME do "field=name" end
    case SearchField.DESCRIPTION do "field=description" end
    case SearchField.AUTHOR do "field=author" end
    case SearchField.TAG do "field=tags" end
    case SearchField.DEPENDENCY do "field=dependencies" end
    end
  let sort_param be match self.config.sort_by with
    case SortBy.RELEVANCE do "sort=relevance" end
    case SortBy.NAME do "sort=name" end
    case SortBy.DATE do "sort=date" end
    case SortBy.DOWNLOADS do "sort=downloads" end
    case SortBy.DEPENDENTS do "sort=dependents" end
    end
  let limit_param be "limit=" + self.config.max_results.to_string()
  let offset_param be "offset=" + self.config.offset.to_string()
  let url be base_url + "/api/v2/search?q=" + query.url_encode()
  url + "&" + field_param + "&" + sort_param + "&" + limit_param + "&" + offset_param
  return url
end

-- Parse the JSON body returned by the registry into a SearchResponse.
fn parse_results(self, body: String) -> Result<SearchResponse, String>
  let parser be JsonParser{}
  let value be parser.parse(body)
  match value with
  case Ok(json) do
    let response be SearchResponse{}
    -- Extract total count.
    let total_val be json.get("total")
    match total_val with
    case Some(v) do
      response.total = v.as_int().unwrap_or(0)
    end
    case None do
      -- Default to zero when field is absent.
    end
    end
    -- Extract the items array.
    let items be json.get_array("items")
    match items with
    case Some(arr) do
      for item in arr do
        let result be SearchResult{}
        result.name = item.get_string("name").unwrap_or("")
        result.version = item.get_string("version").unwrap_or("0.0.0")
        result.description = item.get_string("description").unwrap_or("")
        result.author = item.get_string("author").unwrap_or("")
        result.downloads = item.get_int("downloads").unwrap_or(0)
        result.last_updated = item.get_string("last_updated").unwrap_or("")
        result.dependencies_count = item.get_int("dependencies_count").unwrap_or(0)
        result.score = item.get_float("score").unwrap_or(0.0)
        -- Parse tags array.
        let tags_arr be item.get_array("tags")
        match tags_arr with
        case Some(ta) do
          for tag_val in ta do
            result.tags.append(tag_val.as_string().unwrap_or(""))
          end
        end
        case None do
          -- No tags for this package.
        end
        end
        response.results.append(result)
      end
    end
    case None do
      return Err("Registry response missing 'items' array")
    end
    end
    return Ok(response)
  end
  case Err(e) do
    return Err("Failed to parse registry JSON: " + e)
  end
  end
end

-- Execute a search against a single registry endpoint.
fn search_registry(self, registry_url: String, query: String) -> Result<SearchResponse, String>
  let url be self.build_query_url(registry_url, query)
  let request be HttpRequest{method: "GET", url: url}
  let client be HttpClient{}
  let response be client.send(request)
  match response with
  case Ok(resp) do
    if resp.status == StatusCode.OK then
      return self.parse_results(resp.body())
    else
      return Err("Registry returned " + resp.status.to_string() + " for query: " + query)
    end
  end
  case Err(e) do
    return Err("Network error querying " + registry_url + ": " + e.message())
  end
  end
end

-- ── Result filtering and sorting ───────────────────────────────────────

-- Filter results using the configured tags filter and minimum download threshold.
fn filter_results(self, results: List<SearchResult>) -> List<SearchResult>
  let filtered be List<SearchResult>[]
  for result in results do
    -- Apply minimum downloads filter.
    if result.downloads < self.config.min_downloads then
      continue
    end
    -- Apply tags filter when provided.
    if self.config.tags_filter.length > 0 then
      let matches_all be true
      for required_tag in self.config.tags_filter do
        let found be false
        for tag in result.tags do
          if tag == required_tag then
            found = true
          end
        end
        if !found then
          matches_all = false
        end
      end
      if !matches_all then
        continue
      end
    end
    filtered.append(result)
  end
  return filtered
end

-- Sort results according to the configured SortBy field.
fn sort_results(self, results: List<SearchResult>) -> List<SearchResult>
  let sorted be results.copy()
  match self.config.sort_by with
  case SortBy.RELEVANCE do
    sorted.sort_by(fn a, b -> b.score.compare(a.score))
  end
  case SortBy.NAME do
    sorted.sort_by(fn a, b -> a.name.compare(b.name))
  end
  case SortBy.DATE do
    sorted.sort_by(fn a, b -> b.last_updated.compare(a.last_updated))
  end
  case SortBy.DOWNLOADS do
    sorted.sort_by(fn a, b -> b.downloads.compare(a.downloads))
  end
  case SortBy.DEPENDENTS do
    sorted.sort_by(fn a, b -> b.dependencies_count.compare(a.dependencies_count))
  end
  end
  return sorted
end

-- ── Public API ───────────────────────────────────────────────────────────

-- Search across all configured registries, cache, and return formatted output.
fn search(self, query: String) -> Result<SearchResponse, String>
  let timer be Timer.start()
  -- Check cache first.
  let cached be self.get_cached(query)
  match cached with
  case Some(resp) do
    resp.search_time = "0ms (cached)"
    return Ok(resp)
  end
  case None do
    -- Proceed with remote search.
  end
  end
  -- Query each registry in priority order.
  let all_results be List<SearchResult>[]
  let errors be List<String>[]
  for registry in self.registries do
    let result be self.search_registry(registry, query)
    match result with
    case Ok(resp) do
      for item in resp.results do
        all_results.append(item)
      end
    end
    case Err(e) do
      errors.append(e)
    end
    end
  end
  -- Filter and sort the aggregated results.
  let filtered be self.filter_results(all_results)
  let sorted be self.sort_results(filtered)
  -- Paginate.
  let start be self.config.offset
  let limit be self.config.max_results
  let page be List<SearchResult>[]
  let mut_idx be 0
  for item in sorted do
    if mut_idx >= start and mut_idx < start + limit then
      page.append(item)
    end
    mut_idx = mut_idx + 1
  end
  let elapsed be timer.elapsed()
  let response be SearchResponse{
    results: page,
    total: sorted.length,
    query: query,
    search_time: elapsed.to_string()
  }
  -- Store in cache.
  self.put_cached(query, response)
  return Ok(response)
end

-- Display formatted search results to standard output.
fn display_results(self, query: String) -> Result<String, String>
  let result be self.search(query)
  match result with
  case Ok(response) do
    let formatted be self.format_response(response)
    return Ok(formatted)
  end
  case Err(e) do
    return Err("Search failed: " + e)
  end
  end
end

export {SearchField, SortBy, SearchResult, SearchConfig, SearchResponse, PackageSearcher}
