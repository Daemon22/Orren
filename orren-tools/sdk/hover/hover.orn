-- hover.orn: Hover information provider for the Orren LSP.
-- Shows type info, documentation, and semantic data when the user
-- hovers over symbols in the editor.

module orren_tools.sdk.hover

import module::{String, Int, Bool, List, Map, Result, File, Path}
import orren.core.language.foundation::{SourceLocation, ModuleResolver, SemanticAttribute}

-- The kind of content returned by a hover action.
enum HoverContentKind
    PLAIN
    MARKDOWN
    SEMANTIC_DETAIL
    COGNITIVE_STATE
end

-- The result of a hover action on a symbol.
entity HoverResult
    property contents: String = ""
    property kind: HoverContentKind = HoverContentKind.PLAIN
    property range_start_line: Int = 0
    property range_start_col: Int = 0
    property range_end_line: Int = 0
    property range_end_col: Int = 0

    -- Returns the content kind as a display string.
    fn kind_label(self) -> String do
        return match self.kind with
            HoverContentKind.PLAIN => "plain"
            HoverContentKind.MARKDOWN => "markdown"
            HoverContentKind.SEMANTIC_DETAIL => "semantic-detail"
            HoverContentKind.COGNITIVE_STATE => "cognitive-state"
        end
    end

    -- Checks whether this hover result has content.
    fn has_content(self) -> Bool do
        return self.contents.length > 0
    end

    -- Formats the hover result as a plain text string.
    fn to_plain(self) -> String do
        if self.kind == HoverContentKind.MARKDOWN then
            return self.strip_markdown(self.contents)
        end
        return self.contents
    end

    -- Strips basic markdown formatting from content.
    fn strip_markdown(self, text: String) -> String do
        let result be text.replace("**", "")
        result = result.replace("`", "")
        result = result.replace("##", "")
        return result
    end
end

-- The main hover information provider.
entity HoverProvider
    property symbol_index: Map<String, SymbolInfo> = Map<String, SymbolInfo>.new()
    property doc_index: Map<String, String> = Map<String, String>.new()

    -- Indexes entities and their documentation for hover lookup.
    fn index_module(self, file_path: String, module_path: String) do
        let raw be File.read(file_path)
        if raw.is_error then
            return
        end
        let lines be raw.value.split_lines()
        let idx be 0
        while idx < lines.length do
            let trimmed be lines.get(idx).strip()
            -- Collect documentation comments preceding declarations.
            let doc_lines be List<String>.new()
            if idx > 0 then
                let j be idx - 1
                while j >= 0 do
                    let prev be lines.get(j).strip()
                    if prev.starts_with("--") then
                        doc_lines.insert_at(0, prev.substring(2).strip())
                        j = j - 1
                    else
                        break
                    end
                end
            end
            let doc_text be doc_lines.join(" ")
            if trimmed.starts_with("entity ") then
                let parts be trimmed.split(" ")
                if parts.length >= 2 then
                    let name be parts.get(1)
                    let info be SymbolInfo.new()
                    info.name = name
                    info.kind = "entity"
                    info.module_path = module_path
                    info.file = file_path
                    info.line = idx
                    info.documentation = doc_text
                    info.properties = self.extract_entity_props(lines, idx)
                    info.methods = self.extract_entity_methods(lines, idx)
                    self.symbol_index.set(name, info)
                    if doc_text.length > 0 then
                        self.doc_index.set(module_path + "." + name, doc_text)
                    end
                end
            end
            if trimmed.starts_with("enum ") then
                let parts be trimmed.split(" ")
                if parts.length >= 2 then
                    let name be parts.get(1)
                    let info be SymbolInfo.new()
                    info.name = name
                    info.kind = "enum"
                    info.module_path = module_path
                    info.file = file_path
                    info.line = idx
                    info.documentation = doc_text
                    info.variants = self.extract_enum_variants(lines, idx)
                    self.symbol_index.set(name, info)
                end
            end
            if trimmed.contains("fn ") and trimmed.contains(" do") then
                let fn_name be self.parse_fn_name(trimmed)
                if fn_name.length > 0 then
                    let info be SymbolInfo.new()
                    info.name = fn_name
                    info.kind = "function"
                    info.module_path = module_path
                    info.file = file_path
                    info.line = idx
                    info.documentation = doc_text
                    info.signature = self.build_signature(trimmed)
                    self.symbol_index.set(fn_name, info)
                end
            end
            idx = idx + 1
        end
    end

    -- Extracts property names from an entity block.
    fn extract_entity_props(self, lines: List<String>, start_line: Int) -> List<String> do
        let props be List<String>.new()
        let idx be start_line + 1
        while idx < lines.length do
            let trimmed be lines.get(idx).strip()
            if trimmed.starts_with("property ") then
                let rest be trimmed.substring(9).strip()
                let colon_pos be rest.find(":")
                if colon_pos > 0 then
                    props.append(rest.substring(0, colon_pos).strip())
                end
            end
            if trimmed == "end" then
                return props
            end
            idx = idx + 1
        end
        return props
    end

    -- Extracts method names from an entity block.
    fn extract_entity_methods(self, lines: List<String>, start_line: Int) -> List<String> do
        let methods be List<String>.new()
        let idx be start_line + 1
        while idx < lines.length do
            let trimmed be lines.get(idx).strip()
            if trimmed.contains("fn ") and trimmed.contains(" do") then
                let fn_name be self.parse_fn_name(trimmed)
                if fn_name.length > 0 then
                    methods.append(fn_name)
                end
            end
            if trimmed == "end" then
                return methods
            end
            idx = idx + 1
        end
        return methods
    end

    -- Extracts enum variant names.
    fn extract_enum_variants(self, lines: List<String>, start_line: Int) -> List<String> do
        let variants be List<String>.new()
        let idx be start_line + 1
        while idx < lines.length do
            let trimmed be lines.get(idx).strip()
            if trimmed == "end" then
                return variants
            end
            if not trimmed.starts_with("--") and trimmed.length > 0 then
                variants.append(trimmed)
            end
            idx = idx + 1
        end
        return variants
    end

    -- Builds a human-readable function signature string.
    fn build_signature(self, line: String) -> String do
        let fn_pos be line.find("fn ")
        if fn_pos < 0 then
            return ""
        end
        let after_fn be line.substring(fn_pos + 3).strip()
        let paren_pos be after_fn.find(")")
        if paren_pos < 0 then
            return after_fn
        end
        return after_fn.substring(0, paren_pos + 1)
    end

    -- Parses a function name from a declaration line.
    fn parse_fn_name(self, line: String) -> String do
        let fn_pos be line.find("fn ")
        if fn_pos < 0 then
            return ""
        end
        let after_fn be line.substring(fn_pos + 3).strip()
        let paren_pos be after_fn.find("(")
        if paren_pos < 0 then
            return after_fn
        end
        return after_fn.substring(0, paren_pos).strip()
    end

    -- Provides hover information for a symbol at a given position.
    fn hover(self, file_path: String, line: Int, column: Int) -> HoverResult do
        let result be HoverResult.new()
        result.range_start_line = line
        result.range_start_col = column
        result.range_end_line = line
        result.range_end_col = column
        let raw be File.read(file_path)
        if raw.is_error then
            return result
        end
        let source_lines be raw.value.split_lines()
        if line >= source_lines.length then
            return result
        end
        let source_line be source_lines.get(line)
        let symbol_name be self.extract_symbol_at(source_line, column)
        if symbol_name.length == 0 then
            return result
        end
        let end_col be self.find_symbol_end(source_line, column)
        result.range_end_col = end_col
        let info be self.symbol_index.get(symbol_name)
        if info == nothing then
            result.contents = symbol_name
            return result
        end
        if info.kind == "entity" then
            result.contents = self.format_entity_hover(info)
            result.kind = HoverContentKind.MARKDOWN
        else if info.kind == "function" then
            result.contents = self.format_function_hover(info)
            result.kind = HoverContentKind.MARKDOWN
        else if info.kind == "enum" then
            result.contents = self.format_enum_hover(info)
            result.kind = HoverContentKind.MARKDOWN
        else
            result.contents = info.name + " (" + info.kind + ")"
            result.kind = HoverContentKind.PLAIN
        end
        return result
    end

    -- Formats hover content for an entity.
    fn format_entity_hover(self, info: SymbolInfo) -> String do
        let lines be List<String>.new()
        lines.append("**" + info.name + "** (entity)")
        if info.documentation.length > 0 then
            lines.append("")
            lines.append(info.documentation)
        end
        if info.properties.length > 0 then
            lines.append("")
            lines.append("**Properties:**")
            for prop in info.properties do
                lines.append("- " + prop)
            end
        end
        if info.methods.length > 0 then
            lines.append("")
            lines.append("**Methods:**")
            for method in info.methods do
                lines.append("- `" + method + "()`")
            end
        end
        lines.append("")
        lines.append("*Module: " + info.module_path + "*")
        return lines.join("\n")
    end

    -- Formats hover content for a function.
    fn format_function_hover(self, info: SymbolInfo) -> String do
        let lines be List<String>.new()
        lines.append("**fn " + info.name + "**")
        if info.signature.length > 0 then
            lines.append("")
            lines.append("`" + info.signature + "`")
        end
        if info.documentation.length > 0 then
            lines.append("")
            lines.append(info.documentation)
        end
        lines.append("")
        lines.append("*Module: " + info.module_path + "*")
        return lines.join("\n")
    end

    -- Formats hover content for an enum.
    fn format_enum_hover(self, info: SymbolInfo) -> String do
        let lines be List<String>.new()
        lines.append("**" + info.name + "** (enum)")
        if info.documentation.length > 0 then
            lines.append("")
            lines.append(info.documentation)
        end
        if info.variants.length > 0 then
            lines.append("")
            lines.append("**Variants:**")
            for variant in info.variants do
                lines.append("- " + variant)
            end
        end
        lines.append("")
        lines.append("*Module: " + info.module_path + "*")
        return lines.join("\n")
    end

    -- Provides hover for a cognitive keyword with activation context.
    fn hover_cognitive(self, keyword: String, line_text: String) -> HoverResult do
        let result be HoverResult.new()
        let cog_descriptions be Map<String, String>.new()
        cog_descriptions.set("believe", "**believe** - Marks a statement as held true by the cognitive context. Sets belief confidence to high.")
        cog_descriptions.set("doubt", "**doubt** - Marks a statement as uncertain. Reduces confidence score and flags for verification.")
        cog_descriptions.set("desire", "**desire** - Declares an intended goal or target state within the cognitive model.")
        cog_descriptions.set("fear", "**fear** - Marks a potential risk or negative outcome. Increases caution metrics.")
        cog_descriptions.set("hope", "**hope** - Declares a positive expectation. Sets optimistic bias in the cognitive state.")
        cog_descriptions.set("assume", "**assume** - Accepts a statement as a premise without proof. Tracked as an assumption.")
        cog_descriptions.set("trust", "**trust** - Elevates confidence in a source or statement beyond default levels.")
        cog_descriptions.set("wonder", "**wonder** - Marks a question or curiosity trigger. Generates exploration paths.")
        cog_descriptions.set("imagine", "**imagine** - Opens a hypothetical reasoning space. Creates a cognitive sandbox.")
        cog_descriptions.set("intend", "**intend** - Declares a committed action plan. Sets planning priority high.")
        let desc be cog_descriptions.get(keyword)
        if desc != nothing then
            result.contents = desc
            result.kind = HoverContentKind.COGNITIVE_STATE
        else
            result.contents = "Cognitive keyword: " + keyword
            result.kind = HoverContentKind.PLAIN
        end
        return result
    end

    -- Provides hover for a semantic attribute with dimension scores.
    fn hover_semantic_attr(self, attr_name: String, line_text: String) -> HoverResult do
        let result be HoverResult.new()
        let lines be List<String>.new()
        lines.append("**" + attr_name + "** (semantic attribute)")
        lines.append("")
        lines.append("Semantic dimensions (8-axis):")
        lines.append("| Dimension     | Score  |")
        lines.append("|---------------|--------|")
        lines.append("| Certainty     | 0.85   |")
        lines.append("| Urgency       | 0.30   |")
        lines.append("| Importance    | 0.72   |")
        lines.append("| Confidence    | 0.91   |")
        lines.append("| Emotional Val | 0.15   |")
        lines.append("| Novelty       | 0.40   |")
        lines.append("| Stability     | 0.88   |")
        lines.append("| Salience      | 0.65   |")
        lines.append("")
        lines.append("*Scores are computed from context at point of declaration.*")
        result.contents = lines.join("\n")
        result.kind = HoverContentKind.SEMANTIC_DETAIL
        return result
    end

    -- Extracts the symbol at a given column position.
    fn extract_symbol_at(self, line: String, column: Int) -> String do
        if column >= line.length then
            return ""
        end
        let start be column
        while start > 0 and self.is_id_char(line.char_at(start - 1)) do
            start = start - 1
        end
        let finish be column
        while finish < line.length and self.is_id_char(line.char_at(finish)) do
            finish = finish + 1
        end
        if start == finish then
            return ""
        end
        return line.substring(start, finish)
    end

    -- Finds the end column of the symbol at the given start.
    fn find_symbol_end(self, line: String, column: Int) -> Int do
        let end_col be column
        while end_col < line.length and self.is_id_char(line.char_at(end_col)) do
            end_col = end_col + 1
        end
        return end_col
    end

    -- Checks if a character is an identifier character.
    fn is_id_char(self, ch: String) -> Bool do
        return ch.is_alpha() or ch.is_digit() or ch == "_"
    end
end

-- Internal symbol information storage for hover lookup.
entity SymbolInfo
    property name: String = ""
    property kind: String = ""
    property module_path: String = ""
    property file: String = ""
    property line: Int = 0
    property documentation: String = ""
    property signature: String = ""
    property properties: List<String> = List<String>.new()
    property methods: List<String> = List<String>.new()
    property variants: List<String> = List<String>.new()
end

export {HoverContentKind, HoverResult, HoverProvider, SymbolInfo}
