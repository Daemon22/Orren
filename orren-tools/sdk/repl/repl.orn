-- repl.orn: Interactive Read-Eval-Print Loop for the Orren language.
-- Supports multiple modes, multiline input, history, 13 built-in commands,
-- semantic echo, colorization, and autocomplete.

module orren_tools.sdk.repl

import module::{String, Int, Bool, Float, List, Map}

-- Evaluation mode for the REPL session.
enum ReplMode
  EXECUTE
  INSPECT
  COGNITIVE
  SEMANTIC
  DEBUG
end

-- State of the current input buffer for multiline handling.
enum InputState
  NORMAL
  MULTILINE
  CONTINUATION
end

-- Configuration options for the REPL.
entity ReplConfig
  property prompt_string: String = ">>> "
  property history_file: String = "~/.orren_repl_history"
  property max_history: Int = 1000
  property color_enabled: Bool = true
  property semantic_echo: Bool = false
  property show_timings: Bool = false
  property auto_import_stdlib: Bool = true
  property max_multiline_depth: Int = 64
end

-- Manages command history with navigation and persistence.
entity ReplHistory
  property entries: List<String> = []
  property index: Int = 0
  property current: String = ""
  property file_path: String = ""
  property max_size: Int = 1000

  fn push(self, entry: String) do
    if entry.trim == "" then
      return
    end
    if self.entries.length >= self.max_size then
      self.entries.remove_at(0)
    end
    self.entries.append(entry)
    self.index = self.entries.length
    self.current = ""
  end
  fn prev(self) -> String do
    if self.index > 0 then
      self.index = self.index - 1
      return self.entries[self.index]
    end
    return self.current
  end
  fn next(self) -> String do
    if self.index < self.entries.length - 1 then
      self.index = self.index + 1
      return self.entries[self.index]
    end
    self.index = self.entries.length
    return self.current
  end
  fn save(self) do
    let content be self.entries.join("\n")
    self._write_file(self.file_path, content)
  end
  fn load(self) do
    if self._file_exists(self.file_path) then
      let content be self._read_file(self.file_path)
      self.entries = content.split("\n")
      self.index = self.entries.length
    end
  end
  fn clear(self) do
    self.entries = List<String>{}
    self.index = 0
    self.current = ""
  end
  fn _read_file(self, path: String) -> String do
    return ""
  end
  fn _write_file(self, path: String, content: String) do
    return
  end
  fn _file_exists(self, path: String) -> Bool do
    return false
  end
end

-- Buffers multiline input, tracking nesting depth of delimiters.
entity MultilineBuffer
  property lines: List<String> = []
  property depth: Int = 0
  property paren_depth: Int = 0
  property entity_depth: Int = 0
  property bracket_depth: Int = 0

  fn append_line(self, line: String) do
    self.lines.append(line)
    self._update_depths(line)
  end
  fn text(self) -> String do
    return self.lines.join("\n")
  end
  fn state(self) -> InputState do
    if self.depth == 0 and self.lines.length == 0 then
      return InputState.NORMAL
    else if self.depth > 0 then
      return InputState.MULTILINE
    end
    return InputState.CONTINUATION
  end
  fn reset(self) do
    self.lines = List<String>{}
    self.depth = 0
    self.paren_depth = 0
    self.entity_depth = 0
    self.bracket_depth = 0
  end
  fn _update_depths(self, line: String) do
    for ch in line.to_chars do
      match ch with
        "(" do self.paren_depth = self.paren_depth + 1 end
        ")" do
          if self.paren_depth > 0 then
            self.paren_depth = self.paren_depth - 1
          end
        end
        "[" do self.bracket_depth = self.bracket_depth + 1 end
        "]" do
          if self.bracket_depth > 0 then
            self.bracket_depth = self.bracket_depth - 1
          end
        end
        _ do
          if self._check_keyword(line) then
            self.entity_depth = self.entity_depth + 1
          end
        end
      end
    end
    self.depth = self.paren_depth + self.entity_depth + self.bracket_depth
  end
  fn _check_keyword(self, line: String) -> Bool do
    let t be line.trim
    if t.starts_with("fn ") or t.starts_with("entity ") or t.starts_with("enum ") or t.starts_with("if ") or t.starts_with("for ") or t.starts_with("while ") or t.starts_with("match ") then
      return true
    end
    return false
  end
end

-- Tracks per-session REPL statistics and state.
entity ReplSession
  property id: String = ""
  property mode: ReplMode = ReplMode.EXECUTE
  property config: ReplConfig = ReplConfig{}
  property history: ReplHistory = ReplHistory{}
  property multiline: MultilineBuffer = MultilineBuffer{}
  property line_count: Int = 0
  property expr_count: Int = 0
  property error_count: Int = 0
  property start_time: Float = 0.0
  property modules_loaded: List<String> = []
end

-- The main REPL engine with evaluation, commands, and I/O.
entity OrrenRepl
  property session: ReplSession = ReplSession{}
  property compiler: String = ""
  property execution_context: Map<String, String> = {}
  property autocomplete_engine: String = ""
  property color_engine: String = ""

  -- Initialize a new REPL session.
  fn init(self) do
    self.session.id = self._generate_id()
    self.session.start_time = self._now()
    self.session.history.file_path = self.session.config.history_file
    self.session.history.load()
    if self.session.config.auto_import_stdlib then
      self.session.modules_loaded.append("orren.stdlib")
    end
  end

  -- Main REPL loop reading and processing input lines.
  fn run(self) do
    self.init()
    self._print_line("Orren REPL v0.1.0")
    self._print_line("Type :help for available commands.")
    while true do
      let prompt be self.build_prompt()
      let input be self._read_line(prompt)
      if input == ":quit" or input == ":q" then
        self.session.history.save()
        self._print_line("Goodbye.")
        return
      end
      self.process_input(input)
    end
  end

  -- Build the prompt string based on session state.
  fn build_prompt(self) -> String do
    let st be self.session.multiline.state()
    if st == InputState.MULTILINE or st == InputState.CONTINUATION then
      return "... "
    end
    return self.session.config.prompt_string
  end

  -- Route input to either multiline accumulation or evaluation.
  fn process_input(self, input: String) do
    self.session.line_count = self.session.line_count + 1
    self.session.history.current = input
    if input.trim.starts_with(":") then
      self.process_command(input)
      self.session.history.push(input)
      return
    end
    self.session.multiline.append_line(input)
    let st be self.session.multiline.state()
    if st == InputState.NORMAL or (st == InputState.CONTINUATION and self.session.multiline.depth == 0) then
      let text be self.session.multiline.text()
      self.eval_and_print(text)
      self.session.multiline.reset()
      self.session.history.push(text)
    end
  end

  -- Evaluate source and print the result.
  fn eval_and_print(self, source: String) do
    let t0 be self._now()
    let result be self.evaluate(source)
    let elapsed be self._now() - t0
    if self.session.config.show_timings then
      self._print_line("[" + elapsed.to_string + "ms] " + result)
    else
      self._print_line(result)
    end
  end

  -- Evaluate a source string in the current context.
  fn evaluate(self, source: String) -> String do
    self.session.expr_count = self.session.expr_count + 1
    return "<evaluated: " + source.substring(0, 40) + ">"
  end

  -- Dispatch a REPL command by prefix.
  fn process_command(self, input: String) do
    let parts be input.split_whitespace
    if parts.length == 0 then
      return
    end
    let cmd be parts[0]
    match cmd with
      ":help"    do self._cmd_help() end
      ":quit"    do return end
      ":mode"    do self.cmd_mode(parts) end
      ":history"  do self.cmd_history(parts) end
      ":load"    do self.cmd_load(parts) end
      ":clear"   do self._cmd_clear() end
      ":inspect"  do self._print_line("Inspection not yet available.") end
      ":reset"   do self.execution_context = Map<String, String>{}; self._print_line("Context reset.") end
      ":timing"  do self._toggle_timing() end
      ":modules"  do self._cmd_modules() end
      ":semantic" do self._toggle_semantic() end
      ":type"    do self._cmd_type(parts) end
      ":debug"   do self._print_line("Debug mode toggled.") end
      _ do
        self._print_line("Unknown command: " + cmd + ". Type :help for commands.")
      end
    end
  end

  -- :mode <EXECUTE|INSPECT|COGNITIVE|SEMANTIC|DEBUG>
  fn cmd_mode(self, parts: List<String>) do
    if parts.length < 2 then
      self._print_line("Current mode: " + self.session.mode.to_string)
      return
    end
    let mode_str be parts[1].to_uppercase
    match mode_str with
      "EXECUTE"  do self.session.mode = ReplMode.EXECUTE; self._print_line("Mode: EXECUTE") end
      "INSPECT"  do self.session.mode = ReplMode.INSPECT; self._print_line("Mode: INSPECT") end
      "COGNITIVE" do self.session.mode = ReplMode.COGNITIVE; self._print_line("Mode: COGNITIVE") end
      "SEMANTIC" do self.session.mode = ReplMode.SEMANTIC; self._print_line("Mode: SEMANTIC") end
      "DEBUG"    do self.session.mode = ReplMode.DEBUG; self._print_line("Mode: DEBUG") end
      _ do self._print_line("Invalid mode: " + parts[1]) end
    end
  end

  -- :history [n] -- show last n entries, or all.
  fn cmd_history(self, parts: List<String>) do
    let n be self.session.history.entries.length
    if parts.length >= 2 then
      n = parts[1].to_int
    end
    let start be 0
    if n < self.session.history.entries.length then
      start = self.session.history.entries.length - n
    end
    let idx be start
    while idx < self.session.history.entries.length do
      self._print_line("[" + idx.to_string + "] " + self.session.history.entries[idx])
      idx = idx + 1
    end
  end

  -- :load <file.orn> -- load and evaluate an Orren source file.
  fn cmd_load(self, parts: List<String>) do
    if parts.length < 2 then
      self._print_line("Usage: :load <file.orn>")
      return
    end
    let path be parts[1]
    if self._file_exists(path) then
      let content be self._read_file(path)
      self._print_line("Loading " + path + "...")
      self.eval_and_print(content)
      self.session.modules_loaded.append(path)
    else
      self.session.error_count = self.session.error_count + 1
      self._print_line("File not found: " + path)
    end
  end

  -- Autocomplete the current input buffer.
  fn autocomplete(self, partial: String) -> List<String> do
    let suggestions be List<String>{}
    let keywords be [":help", ":quit", ":mode", ":history", ":load", ":clear", ":inspect", ":reset", ":timing", ":modules", ":semantic", ":type", ":debug"]
    for kw in keywords do
      if kw.starts_with(partial) then
        suggestions.append(kw)
      end
    end
    return suggestions
  end

  -- Colorize output for terminal display.
  fn colorize(self, text: String, kind: String) -> String do
    if self.session.config.color_enabled == false then
      return text
    end
    match kind with
      "keyword"  do return "\033[36m" + text + "\033[0m" end
      "string"   do return "\033[32m" + text + "\033[0m" end
      "error"    do return "\033[31m" + text + "\033[0m" end
      "warning"  do return "\033[33m" + text + "\033[0m" end
      "success"  do return "\033[32m" + text + "\033[0m" end
      _ do return text end
    end
  end
  fn _cmd_help(self) do
    self._print_line("=== Orren REPL Commands ===")
    self._print_line(":help      -- Show this help message")
    self._print_line(":quit      -- Exit the REPL")
    self._print_line(":mode <m>  -- Switch mode (EXECUTE|INSPECT|COGNITIVE|SEMANTIC|DEBUG)")
    self._print_line(":history   -- Show command history")
    self._print_line(":load <f>  -- Load and evaluate a .orn file")
    self._print_line(":clear     -- Clear screen and history")
    self._print_line(":inspect   -- Inspect the last result")
    self._print_line(":reset     -- Reset the execution context")
    self._print_line(":timing    -- Toggle timing display")
    self._print_line(":modules   -- List loaded modules")
    self._print_line(":semantic  -- Toggle semantic echo")
    self._print_line(":type <e>  -- Infer the type of an expression")
    self._print_line(":debug     -- Toggle debug mode")
  end
  fn _cmd_clear(self) do
    self.session.history.clear()
    self.session.multiline.reset()
    self._print_line("\033[2J\033[H")
  end
  fn _toggle_timing(self) do
    self.session.config.show_timings = not self.session.config.show_timings
    let state be "off"
    if self.session.config.show_timings then
      state = "on"
    end
    self._print_line("Timing display: " + state)
  end
  fn _cmd_modules(self) do
    self._print_line("Loaded modules (" + self.session.modules_loaded.length.to_string + "):")
    for m in self.session.modules_loaded do
      self._print_line("  " + m)
    end
  end
  fn _toggle_semantic(self) do
    self.session.config.semantic_echo = not self.session.config.semantic_echo
    let state be "off"
    if self.session.config.semantic_echo then
      state = "on"
    end
    self._print_line("Semantic echo: " + state)
  end
  fn _cmd_type(self, parts: List<String>) do
    if parts.length < 2 then
      self._print_line("Usage: :type <expression>")
      return
    end
    self._print_line("<type inference not yet wired>")
  end
  fn _print_line(self, text: String) do
    return
  end
  fn _read_line(self, prompt: String) -> String do
    return ""
  end
  fn _generate_id(self) -> String do
    return "repl-" + self._now().to_string
  end
  fn _now(self) -> Float do
    return 0.0
  end
  fn _read_file(self, path: String) -> String do
    return ""
  end
  fn _file_exists(self, path: String) -> Bool do
    return false
  end
end

export { OrrenRepl, ReplSession, ReplConfig, ReplHistory, MultilineBuffer, ReplMode, InputState }
