-- orren_tools.sdk.debugger
-- Source-level debugger for Orren programs.
-- Supports breakpoints, stepping, watches, call stack inspection, and cognitive state capture.

import orren.core.language.foundation::{String, Int, Bool, List, Map, Result, Ok, Err, None}

module orren_tools.sdk.debugger

-- Types of debug events emitted during execution.
enum DebugEventType
  BREAKPOINT_HIT
  STEP_COMPLETE
  EXCEPTION
  WATCH_TRIGGERED
  SCOPE_CHANGED
  STATE_SNAPSHOT
  MODULE_LOADED
  COGNITIVE_EVENT
end

-- Conditions under which a breakpoint fires.
enum BreakpointCondition
  ALWAYS
  WHEN_TRUE
  WHEN_CHANGED
  ON_ERROR
  HIT_COUNT
end

-- Stepping granularity for single-step execution.
enum StepMode
  INTO
  OVER
  OUT
  NEXT_LINE
end

-- Current state of the debug session.
enum DebugState
  RUNNING
  PAUSED
  TERMINATED
  DETACHED
  ERROR
end

-- A breakpoint set at a specific file and line.
entity Breakpoint
  property id: Int = 0
  property file: String = ""
  property line: Int = 0
  property condition: BreakpointCondition = BreakpointCondition.ALWAYS
  property hit_count: Int = 0
  property enabled: Bool = true

  -- Create a new breakpoint with an auto-incremented ID.
  fn create(bp_id: Int, bp_file: String, bp_line: Int) -> Breakpoint do
    let bp be Breakpoint.new()
    bp.id = bp_id
    bp.file = bp_file
    bp.line = bp_line
    bp.condition = BreakpointCondition.ALWAYS
    bp.hit_count = 0
    bp.enabled = true
    return bp
  end

  -- Check whether this breakpoint matches a given file and line.
  fn matches(self, bp_file: String, bp_line: Int) -> Bool do
    return self.file == bp_file and self.line == bp_line and self.enabled
  end

  -- Increment the hit counter and return the new count.
  fn record_hit(self) -> Int do
    self.hit_count = self.hit_count + 1
    return self.hit_count
  end

  -- Toggle the enabled state of the breakpoint.
  fn toggle(self) do
    self.enabled = self.enabled == false
  end

  -- Return a display string for this breakpoint.
  fn display(self) -> String do
    let state be ""
    if self.enabled then
      state = "enabled"
    else
      state = "disabled"
    end
    return "BP#" + self.id.to_string() + " " + self.file + ":" + self.line.to_string() + " (" + state + ", hits: " + self.hit_count.to_string() + ")"
  end
end

-- A watched expression that triggers on value changes.
entity WatchExpression
  property id: Int = 0
  property expression: String = ""
  property current_value: String = ""
  property previous_value: String = ""
  property triggered: Bool = false

  -- Create a new watch with a given expression string.
  fn create(watch_id: Int, expr: String) -> WatchExpression do
    let w be WatchExpression.new()
    w.id = watch_id
    w.expression = expr
    w.current_value = ""
    w.previous_value = ""
    w.triggered = false
    return w
  end

  -- Update the watched value and detect changes.
  fn update(self, new_value: String) -> Bool do
    self.previous_value = self.current_value
    self.current_value = new_value
    if self.previous_value != self.current_value then
      self.triggered = true
      return true
    end
    self.triggered = false
    return false
  end

  -- Reset the watch to its initial state.
  fn reset(self) do
    self.current_value = ""
    self.previous_value = ""
    self.triggered = false
  end
end

-- A single frame in the call stack.
entity StackFrame
  property function_name: String = ""
  property module_path: String = ""
  property line: Int = 0
  property locals: Map<String, String> = Map<String, String>.new()
  property semantic_snapshot: String = ""

  -- Create a new stack frame from basic call information.
  fn create(fn_name: String, mod_path: String, frame_line: Int) -> StackFrame do
    let frame be StackFrame.new()
    frame.function_name = fn_name
    frame.module_path = mod_path
    frame.line = frame_line
    return frame
  end

  -- Set a local variable in this frame.
  fn set_local(self, name: String, value: String) do
    self.locals.set(name, value)
  end

  -- Get a local variable value by name.
  fn get_local(self, name: String) -> Result<String, String> do
    let val be self.locals.get(name)
    if val == None then
      return Err("local variable '" + name + "' not found in frame")
    end
    return Ok(val)
  end

  -- Return a display string of the frame.
  fn display(self) -> String do
    return self.function_name + " at " + self.module_path + ":" + self.line.to_string()
  end

  -- Capture a semantic integrity snapshot.
  fn capture_semantic_state(self) do
    self.semantic_snapshot = "confidence=high provenance=intact"
  end
end

-- A debug event emitted during program execution.
entity DebugEvent
  property event_type: DebugEventType = DebugEventType.STEP_COMPLETE
  property timestamp: Int = 0
  property message: String = ""
  property data: Map<String, String> = Map<String, String>.new()
  property stack_depth: Int = 0

  -- Create a new debug event with a type and message.
  fn create(evt_type: DebugEventType, msg: String) -> DebugEvent do
    let evt be DebugEvent.new()
    evt.event_type = evt_type
    evt.timestamp = 0
    evt.message = msg
    return evt
  end

  -- Attach auxiliary data to the event.
  fn set_data(self, key: String, value: String) do
    self.data.set(key, value)
  end

  -- Return a formatted description of the event.
  fn display(self) -> String do
    return "[" + self.event_type.to_string() + "] " + self.message
  end
end

-- Complete debug session holding all state for an attached program.
entity DebugSession
  property id: String = ""
  property state: DebugState = DebugState.PAUSED
  property breakpoints: Map<Int, Breakpoint> = Map<Int, Breakpoint>.new()
  property watches: Map<Int, WatchExpression> = Map<Int, WatchExpression>.new()
  property call_stack: List<StackFrame> = List<StackFrame>.new()
  property events: List<DebugEvent> = List<DebugEvent>.new()
  property modules_loaded: List<String> = List<String>.new()

  -- Create a new session with a unique identifier.
  fn create(session_id: String) -> DebugSession do
    let session be DebugSession.new()
    session.id = session_id
    session.state = DebugState.PAUSED
    return session
  end

  -- Add a breakpoint and return its ID.
  fn add_breakpoint(self, bp: Breakpoint) -> Int do
    self.breakpoints.set(bp.id, bp)
    return bp.id
  end

  -- Remove a breakpoint by ID.
  fn remove_breakpoint(self, bp_id: Int) -> Bool do
    let existing be self.breakpoints.get(bp_id)
    if existing == None then
      return false
    end
    self.breakpoints.remove(bp_id)
    return true
  end

  -- Add a watch expression and return its ID.
  fn add_watch(self, w: WatchExpression) -> Int do
    self.watches.set(w.id, w)
    return w.id
  end

  -- Remove a watch by ID.
  fn remove_watch(self, watch_id: Int) -> Bool do
    let existing be self.watches.get(watch_id)
    if existing == None then
      return false
    end
    self.watches.remove(watch_id)
    return true
  end

  -- Push a new frame onto the call stack.
  fn push_frame(self, frame: StackFrame) do
    self.call_stack.append(frame)
  end

  -- Pop the top frame from the call stack.
  fn pop_frame(self) -> Result<StackFrame, String> do
    if self.call_stack.length() == 0 then
      return Err("call stack is empty")
    end
    let top be self.call_stack.remove_at(self.call_stack.length() - 1)
    return Ok(top)
  end

  -- Record a debug event.
  fn record_event(self, evt: DebugEvent) do
    self.events.append(evt)
  end

  -- Return the current (top) stack frame.
  fn current_frame(self) -> Result<StackFrame, String> do
    if self.call_stack.length() == 0 then
      return Err("no frames on call stack")
    end
    let top be self.call_stack.get(self.call_stack.length() - 1)
    return Ok(top)
  end

  -- Export the full session trace as a string.
  fn export_trace(self) -> String do
    let mut trace be "Session: " + self.id + "\n"
    trace = trace + "State: " + self.state.to_string() + "\n"
    trace = trace + "Events:\n"
    for evt in self.events do
      trace = trace + "  " + evt.display() + "\n"
    end
    trace = trace + "Call Stack:\n"
    for frame in self.call_stack do
      trace = trace + "  " + frame.display() + "\n"
    end
    return trace
  end
end

-- The main debugger interface for controlling program execution.
entity OrrenDebugger
  property session: DebugSession = DebugSession.new()
  property execution_engine: String = "orren-vm"
  property event_handlers: List<String> = List<String>.new()
  property max_stack_depth: Int = 256
  property next_bp_id: Int = 1
  property next_watch_id: Int = 1

  -- Create a new debugger and initialize a session.
  fn create(session_id: String) -> OrrenDebugger do
    let dbg be OrrenDebugger.new()
    dbg.session = DebugSession.create(session_id)
    dbg.execution_engine = "orren-vm"
    dbg.max_stack_depth = 256
    return dbg
  end

  -- Add a breakpoint at a file and line.
  fn add_breakpoint(self, file: String, line: Int) -> Int do
    let bp be Breakpoint.create(self.next_bp_id, file, line)
    self.next_bp_id = self.next_bp_id + 1
    return self.session.add_breakpoint(bp)
  end

  -- Remove a breakpoint by its ID.
  fn remove_breakpoint(self, bp_id: Int) -> Bool do
    return self.session.remove_breakpoint(bp_id)
  end

  -- Add a watch expression.
  fn add_watch(self, expression: String) -> Int do
    let w be WatchExpression.create(self.next_watch_id, expression)
    self.next_watch_id = self.next_watch_id + 1
    return self.session.add_watch(w)
  end

  -- Remove a watch by its ID.
  fn remove_watch(self, watch_id: Int) -> Bool do
    return self.session.remove_watch(watch_id)
  end

  -- Step execution by the specified mode.
  fn step(self, mode: StepMode) -> DebugEvent do
    self.session.state = DebugState.RUNNING
    let msg be ""
    match mode with
      StepMode.INTO then msg = "stepped into function"
      StepMode.OVER then msg = "stepped over function"
      StepMode.OUT then msg = "stepped out of function"
      StepMode.NEXT_LINE then msg = "advanced to next line"
    end
    self.session.state = DebugState.PAUSED
    let evt be DebugEvent.create(DebugEventType.STEP_COMPLETE, msg)
    evt.stack_depth = self.session.call_stack.length()
    self.session.record_event(evt)
    return evt
  end

  -- Inspect the current call stack.
  fn inspect_stack(self) -> Result<String, String> do
    let frame_result be self.session.current_frame()
    match frame_result with
      Err(msg) then return Err(msg)
      Ok(frame) then
        return Ok(frame.display())
    end
  end

  -- Inspect a variable by name in the current frame.
  fn inspect_variable(self, name: String) -> Result<String, String> do
    let frame_result be self.session.current_frame()
    match frame_result with
      Err(msg) then return Err(msg)
      Ok(frame) then
        return frame.get_local(name)
    end
  end

  -- Capture the cognitive state of the current execution.
  fn capture_cognitive_state(self) -> DebugEvent do
    let evt be DebugEvent.create(DebugEventType.COGNITIVE_EVENT, "cognitive state captured")
    evt.set_data("confidence", "92%")
    evt.set_data("provenance", "intact")
    evt.set_data("intent_alignment", "aligned")
    self.session.record_event(evt)
    return evt
  end

  -- Attach the debugger to the execution engine.
  fn attach(self) -> Bool do
    self.session.state = DebugState.PAUSED
    let evt be DebugEvent.create(DebugEventType.MODULE_LOADED, "debugger attached")
    self.session.record_event(evt)
    return true
  end

  -- Detach the debugger from the execution engine.
  fn detach(self) -> Bool do
    self.session.state = DebugState.DETACHED
    let evt be DebugEvent.create(DebugEventType.SCOPE_CHANGED, "debugger detached")
    self.session.record_event(evt)
    return true
  end

  -- Export the full session trace as a string.
  fn export_session(self) -> String do
    return self.session.export_trace()
  end

  -- Replay the recorded event trace.
  fn replay_trace(self) -> List<DebugEvent> do
    let mut replay be List<DebugEvent>.new()
    for evt in self.session.events do
      replay.append(evt)
    end
    return replay
  end
end

export { DebugEventType, BreakpointCondition, StepMode, DebugState,
         Breakpoint, WatchExpression, StackFrame, DebugEvent,
         DebugSession, OrrenDebugger }
