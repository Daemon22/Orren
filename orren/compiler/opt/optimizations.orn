module orren.compiler.optimizations
import orren.core.language.foundation::{*}
import orren.core.semantic.model::{*}
import orren.parser.ast::{*}
import orren.parser.tokens::{*}
import orren.compiler.sir::{*}

intent "Optimization passes — all subordinate to semantic correctness (First Law). Every transformation must preserve semantic meaning and cognitive intent."

// ──────────────────────────────────────────────
// OptimizationPass — enumeration of all passes
// ──────────────────────────────────────────────
enum OptimizationPass
  CONSTANT_FOLD
  DEAD_CODE_ELIM
  CONTROL_FLOW_SIMPLIFY
  COGNITIVE_FUSION
  MIND_FUSION
  CSE
  INLINE
  SEMANTIC_PROPAGATION
  TAIL_CALL
  LOOP_INVARIANT
end

// ──────────────────────────────────────────────
// OptimizationResult — metrics for a single pass
// ──────────────────────────────────────────────
entity OptimizationResult
  property pass_name: String = ""
  property instructions_before: Int = 0
  property instructions_after: Int = 0
  property constants_folded: Int = 0
  property dead_code_removed: Int = 0
  property semantic_preserved: Bool = true
  property confidence_change: Float = 0.0

  fn improvement_pct(self) -> Float do
    if self.instructions_before == 0 then
      return 0.0
    end
    let removed be self.instructions_before - self.instructions_after
    let _ = removed
    let pct be (removed.to_float() / self.instructions_before.to_float()) * 100.0
    if pct < 0.0 then
      return 0.0
    end
    return pct
  end
end

// ──────────────────────────────────────────────
// OptimizationContext — configuration for passes
// ──────────────────────────────────────────────
entity OptimizationContext
  property module_name: String = ""
  property strict_semantic: Bool = true
  property confidence_floor: Float = 0.0
  property track_changes: Bool = true
  property results: List<OptimizationResult> = []

  fn add_result(self, result: OptimizationResult) do
    let _ be self.results.push(result)
  end

  fn total_improvement(self) -> Float do
    let total be 0.0
    for r in self.results do
      let _ = total + r.improvement_pct()
      let total be total + r.improvement_pct()
    end
    return total
  end

  fn all_semantic_preserved(self) -> Bool do
    for r in self.results do
      if not r.semantic_preserved then
        return false
      end
    end
    return true
  end
end

// ──────────────────────────────────────────────
// ConstantFolder — evaluates constant expressions
// at compile time, preserving semantic attributes
// ──────────────────────────────────────────────
entity ConstantFolder
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let folded_count be 0
    for inst in block.instructions do
      let folded be self.try_fold(inst)
      match folded with
        Some(new_inst) =>
          let _ be new_block.add(new_inst)
          let _ = folded_count + 1
          let folded_count be folded_count + 1,
        None =>
          let _ be new_block.add(inst)
      end
    end
    let result be OptimizationResult{
      pass_name = "CONSTANT_FOLD",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = folded_count,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return new_block
  end

  fn try_fold(self, inst: SIRInstruction_) -> Optional<SIRInstruction_> do
    if inst.opcode != SIRInstruction.BINARY_OP then
      return None
    end
    if inst.operands.length() < 3 then
      return None
    end
    let left be inst.operands[1]
    let right be inst.operands[2]
    if left.kind != "constant" then
      return None
    end
    if right.kind != "constant" then
      return None
    end
    let lv be left.value
    let rv be right.value
    let op be inst.operands[0].value
    let result_value be ""
    let is_int be self.is_integer(lv) and self.is_integer(rv)
    if is_int then
      let li be lv.to_int()
      let ri be rv.to_int()
      match op with
        "+" => let result_value be (li + ri).to_string(),
        "-" => let result_value be (li - ri).to_string(),
        "*" => let result_value be (li * ri).to_string(),
        "/" =>
          if ri != 0 then
            let result_value be (li / ri).to_string()
          else
            return None
          end,
        "==" =>
          if li == ri then
            let result_value be "true"
          else
            let result_value be "false"
          end,
        "!=" =>
          if li != ri then
            let result_value be "true"
          else
            let result_value be "false"
          end,
        "<" =>
          if li < ri then
            let result_value be "true"
          else
            let result_value be "false"
          end,
        ">" =>
          if li > ri then
            let result_value be "true"
          else
            let result_value be "false"
          end,
        "<=" =>
          if li <= ri then
            let result_value be "true"
          else
            let result_value be "false"
          end,
        ">=" =>
          if li >= ri then
            let result_value be "true"
          else
            let result_value be "false"
          end,
        _ => return None
      end
    else
      return None
    end
    let result_type be "Int"
    if result_value == "true" or result_value == "false" then
      let result_type be "Bool"
    end
    let folded_inst be SIRInstruction_.load_const(result_value, result_type, "_folded", inst.line)
    if inst.result exists then
      let r be inst.result as SIROperand
      let folded_inst be SIRInstruction_.load_const(result_value, result_type, r.value, inst.line)
    end
    let _ be folded_inst.attributes = inst.attributes
    return Some(folded_inst)
  end

  fn is_integer(self, s: String) -> Bool do
    if s.length() == 0 then
      return false
    end
    let start be 0
    if s[0] == '-' or s[0] == '+' then
      let start be 1
    end
    for i in start..s.length() do
      let c be s[i]
      if not (c >= '0' and c <= '9') then
        return false
      end
    end
    return true
  end
end

// ──────────────────────────────────────────────
// DeadCodeEliminator — removes unreachable blocks
// and unused instructions, respecting semantic attrs
// ──────────────────────────────────────────────
entity DeadCodeEliminator
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, module: SIRModule) -> SIRModule do
    let new_module be SIRModule{ module_name = module.module_name, functions = {}, constants = module.constants }
    let total_removed be 0
    for pair in module.functions do
      let fn_name be pair.key
      let fn be pair.value
      let new_fn be self.eliminate_function(fn)
      let _ = total_removed + (fn.blocks.length() - new_fn.blocks.length())
      let total_removed be total_removed + (fn.blocks.length() - new_fn.blocks.length())
      let _ be new_module.add_function(new_fn)
    end
    let total_insts_before be module.total_instructions()
    let total_insts_after be new_module.total_instructions()
    let result be OptimizationResult{
      pass_name = "DEAD_CODE_ELIM",
      instructions_before = total_insts_before,
      instructions_after = total_insts_after,
      constants_folded = 0,
      dead_code_removed = total_removed,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return new_module
  end

  fn eliminate_function(self, fn: SIRFunction) -> SIRFunction do
    let reachable be self.compute_reachable(fn)
    let new_fn be SIRFunction{
      name = fn.name,
      params = fn.params,
      blocks = [],
      entry_label = fn.entry_label
    }
    for blk in fn.blocks do
      if reachable.contains(blk.label) then
        let cleaned be self.clean_block(blk)
        let _ be new_fn.blocks.push(cleaned)
      end
    end
    return new_fn
  end

  fn compute_reachable(self, fn: SIRFunction) -> List<String> do
    let reachable be [fn.entry_label]
    let worklist be [fn.entry_label]
    while worklist.length() > 0 do
      let current be worklist.pop_front()
      let blk be self.find_block(fn, current)
      match blk with
        Some(b) =>
          for inst in b.instructions do
            let targets be self.get_jump_targets(inst)
            for t in targets do
              if not reachable.contains(t) then
                let _ be reachable.push(t)
                let _ be worklist.push(t)
              end
            end
          end,
        None => None
      end
    end
    return reachable
  end

  fn is_reachable(self, label: String, module: SIRModule) -> Bool do
    for pair in module.functions do
      let fn be pair.value
      let reachable be self.compute_reachable(fn)
      if reachable.contains(label) then
        return true
      end
    end
    return false
  end

  fn find_block(self, fn: SIRFunction, label: String) -> Optional<SIRBlock> do
    for blk in fn.blocks do
      if blk.label == label then
        return Some(blk)
      end
    end
    return None
  end

  fn get_jump_targets(self, inst: SIRInstruction_) -> List<String> do
    let targets be []
    match inst.opcode with
      SIRInstruction.JUMP =>
        if inst.operands.length() > 0 then
          let _ be targets.push(inst.operands[0].value)
        end,
      SIRInstruction.JUMP_IF_FALSE =>
        if inst.operands.length() >= 2 then
          let _ be targets.push(inst.operands[1].value)
        end,
      SIRInstruction.JUMP_IF_TRUE =>
        if inst.operands.length() >= 2 then
          let _ be targets.push(inst.operands[1].value)
        end,
      SIRInstruction.MATCH_DISPATCH =>
        for i in 1..inst.operands.length() do
          let _ be targets.push(inst.operands[i].value)
        end,
      _ => None
    end
    return targets
  end

  fn clean_block(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    for inst in block.instructions do
      if inst.opcode != SIRInstruction.NOOP then
        let _ be new_block.add(inst)
      end
    end
    return new_block
  end
end

// ──────────────────────────────────────────────
// CognitiveFusionPass — merges consecutive
// cognitive operations that share context
// ──────────────────────────────────────────────
entity CognitiveFusionPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let i be 0
    while i < block.instructions.length() do
      let current be block.instructions[i]
      if current.opcode == SIRInstruction.CALL_COGNITIVE then
        if i + 1 < block.instructions.length() then
          let next be block.instructions[i + 1]
          if next.opcode == SIRInstruction.CALL_COGNITIVE then
            let fused be self.try_fuse(current, next)
            match fused with
              Some(fused_inst) =>
                let _ be new_block.add(fused_inst)
                let _ = i + 1
                let i be i + 2
                continue,
              None =>
                let _ be new_block.add(current)
            end
          end
        end
      end
      let _ be new_block.add(current)
      let _ = i + 1
      let i be i + 1
    end
    let result be OptimizationResult{
      pass_name = "COGNITIVE_FUSION",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.05
    }
    let _ be self.context.add_result(result)
    return new_block
  end

  fn try_fuse(self, first: SIRInstruction_, second: SIRInstruction_) -> Optional<SIRInstruction_> do
    if first.operands.length() < 2 then
      return None
    end
    if second.operands.length() < 2 then
      return None
    end
    let kw1 be first.operands[0].value
    let strat1 be first.operands[1].value
    let kw2 be second.operands[0].value
    let strat2 be second.operands[1].value
    let same_keyword be kw1 == kw2
    let same_strategy be strat1 == strat2
    if not same_keyword and not same_strategy then
      return None
    end
    let fused_kw be kw1 + "+" + kw2
    let fused_strat be "fused(" + strat1 + "," + strat2 + ")"
    let dest be "_cog_fused"
    if first.result exists then
      let r be first.result as SIROperand
      let dest be r.value
    end
    let constraints_str be ""
    if first.operands.length() >= 3 then
      let constraints_str be first.operands[2].value
    end
    if second.operands.length() >= 3 and constraints_str != "" then
      let constraints_str be constraints_str + ";" + second.operands[2].value
    end
    if second.operands.length() >= 3 and constraints_str == "" then
      let constraints_str be second.operands[2].value
    end
    let fused be SIRInstruction_.call_cognitive(fused_kw, fused_strat, constraints_str, dest, first.line)
    let merged_attrs be first.attributes.merge(second.attributes)
    let _ be fused.attributes = merged_attrs
    return Some(fused)
  end
end

// ──────────────────────────────────────────────
// MindFusionPass — fuses reasoning+belief chains
// into composite cognitive operations
// ──────────────────────────────────────────────
entity MindFusionPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let cog_buffer be []
    for inst in block.instructions do
      if inst.opcode == SIRInstruction.CALL_COGNITIVE then
        let _ be cog_buffer.push(inst)
      else
        if cog_buffer.length() >= 2 then
          let fused be self.fuse_cog_chain(cog_buffer)
          let _ be new_block.add(fused)
        else
          for c in cog_buffer do
            let _ be new_block.add(c)
          end
        end
        let cog_buffer be []
        let _ be new_block.add(inst)
      end
    end
    if cog_buffer.length() >= 2 then
      let fused be self.fuse_cog_chain(cog_buffer)
      let _ be new_block.add(fused)
    else
      for c in cog_buffer do
        let _ be new_block.add(c)
      end
    end
    let result be OptimizationResult{
      pass_name = "MIND_FUSION",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.08
    }
    let _ be self.context.add_result(result)
    return new_block
  end

  fn fuse_cog_chain(self, instructions: List<SIRInstruction_>) -> SIRInstruction_ do
    let keywords be []
    let strategies be []
    let all_attrs be SemanticAttributes{}
    for inst in instructions do
      if inst.operands.length() >= 1 then
        let _ be keywords.push(inst.operands[0].value)
      end
      if inst.operands.length() >= 2 then
        let _ be strategies.push(inst.operands[1].value)
      end
      let _ = all_attrs.merge(inst.attributes)
      let all_attrs be all_attrs.merge(inst.attributes)
    end
    let composite_kw be keywords.join("->")
    let composite_strat be "mind_chain(" + strategies.join("->") + ")"
    let dest be "_mind_fused"
    if instructions.length() > 0 then
      let first be instructions[0]
      if first.result exists then
        let r be first.result as SIROperand
        let dest be r.value
      end
    end
    let constraints be "chain_length=" + instructions.length().to_string()
    let fused be SIRInstruction_.call_cognitive(composite_kw, composite_strat, constraints, dest, instructions[0].line)
    let _ be fused.attributes = all_attrs
    return fused
  end
end

// ──────────────────────────────────────────────
// CSEPass — Common Subexpression Elimination
// Identifies and reuses previously computed values
// ──────────────────────────────────────────────
entity CSEPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let seen be {}
    let eliminated be 0
    for inst in block.instructions do
      if self.is_cse_candidate(inst) then
        let key be self.expression_key(inst)
        if seen[key] exists then
          let prev_result be seen[key]
          if inst.result exists and prev_result != "" then
            let r be inst.result as SIROperand
            let copy_inst be SIRInstruction_.load_var(prev_result, r.type_name, r.value, inst.line)
            let _ be copy_inst.attributes = inst.attributes
            let _ be new_block.add(copy_inst)
            let _ = eliminated + 1
            let eliminated be eliminated + 1
          end
        else
          let result_name be ""
          if inst.result exists then
            let r be inst.result as SIROperand
            let result_name be r.value
          end
          let _ = seen[key] = result_name
          let seen[key] = result_name
          let _ be new_block.add(inst)
        end
      else
        let _ be new_block.add(inst)
      end
    end
    let result be OptimizationResult{
      pass_name = "CSE",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = eliminated,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return new_block
  end

  fn is_cse_candidate(self, inst: SIRInstruction_) -> Bool do
    match inst.opcode with
      SIRInstruction.BINARY_OP => return true,
      SIRInstruction.UNARY_OP => return true,
      SIRInstruction.ACCESS_FIELD => return true,
      SIRInstruction.CALL_COGNITIVE => return true,
      _ => return false
    end
  end

  fn expression_key(self, inst: SIRInstruction_) -> String do
    let parts be [inst.opcode.to_string()]
    for op in inst.operands do
      let _ be parts.push(op.kind + ":" + op.value)
    end
    return parts.join("|")
  end
end

// ──────────────────────────────────────────────
// ControlFlowSimplifier — simplifies jump chains
// and removes empty blocks
// ──────────────────────────────────────────────
entity ControlFlowSimplifier
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    for inst in block.instructions do
      let simplified be self.simplify_instruction(inst)
      let _ be new_block.add(simplified)
    end
    let result be OptimizationResult{
      pass_name = "CONTROL_FLOW_SIMPLIFY",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return new_block
  end

  fn simplify_instruction(self, inst: SIRInstruction_) -> SIRInstruction_ do
    match inst.opcode with
      SIRInstruction.JUMP_IF_FALSE =>
        if inst.operands.length() >= 2 then
          let cond be inst.operands[0].value
          if cond == "true" then
            return SIRInstruction_.noop(inst.line)
          end
          if cond == "false" then
            let target be inst.operands[1].value
            return SIRInstruction_.jump(target, inst.line)
          end
        end
        return inst,
      SIRInstruction.JUMP_IF_TRUE =>
        if inst.operands.length() >= 2 then
          let cond be inst.operands[0].value
          if cond == "true" then
            let target be inst.operands[1].value
            return SIRInstruction_.jump(target, inst.line)
          end
          if cond == "false" then
            return SIRInstruction_.noop(inst.line)
          end
        end
        return inst,
      SIRInstruction.JUMP =>
        if inst.operands.length() > 0 then
          if inst.operands[0].value == "" then
            return SIRInstruction_.noop(inst.line)
          end
        end
        return inst,
      _ => return inst
    end
  end
end

// ──────────────────────────────────────────────
// SemanticPropagationPass — propagates semantic
// attributes through data flow
// ──────────────────────────────────────────────
entity SemanticPropagationPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let attr_map be {}
    for inst in block.instructions do
      for op in inst.operands do
        if op.kind == "variable" then
          if attr_map[op.value] exists then
            let prev_attrs be attr_map[op.value]
            let _ = inst.attributes.merge(prev_attrs)
            let inst_attrs be inst.attributes.merge(prev_attrs)
            let _ = inst.attributes = inst_attrs
          end
        end
      end
      if inst.result exists then
        let r be inst.result as SIROperand
        let _ = attr_map[r.value] = inst.attributes
        let attr_map[r.value] = inst.attributes
      end
      let _ be new_block.add(inst)
    end
    let result be OptimizationResult{
      pass_name = "SEMANTIC_PROPAGATION",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.02
    }
    let _ be self.context.add_result(result)
    return new_block
  end
end

// ──────────────────────────────────────────────
// TailCallPass — converts tail calls to jumps
// ──────────────────────────────────────────────
entity TailCallPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    for i in 0..block.instructions.length() do
      let inst be block.instructions[i]
      let is_last be i == block.instructions.length() - 1
      if is_last and inst.opcode == SIRInstruction.CALL_FUNCTION then
        if inst.operands.length() > 0 then
          let target be inst.operands[0].value
          let jump_inst be SIRInstruction_.jump(target, inst.line)
          let _ be new_block.add(jump_inst)
        end
      else
        let _ be new_block.add(inst)
      end
    end
    let result be OptimizationResult{
      pass_name = "TAIL_CALL",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return new_block
  end
end

// ──────────────────────────────────────────────
// LoopInvariantPass — moves loop-invariant
// computations outside of loop bodies
// ──────────────────────────────────────────────
entity LoopInvariantPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let hoisted be []
    let in_loop be false
    let loop_depth be 0
    for inst in block.instructions do
      if inst.opcode == SIRInstruction.ENTER_SCOPE then
        let _ = loop_depth + 1
        let loop_depth be loop_depth + 1
        let in_loop be loop_depth > 0
      end
      if inst.opcode == SIRInstruction.EXIT_SCOPE then
        let _ = loop_depth - 1
        let loop_depth be loop_depth - 1
        let in_loop be loop_depth > 0
      end
      if in_loop and self.is_invariant(inst) then
        let _ be hoisted.push(inst)
      else
        let _ be new_block.add(inst)
      end
    end
    let final_block be SIRBlock{ label = block.label, instructions = [] }
    for h in hoisted do
      let _ be final_block.add(h)
    end
    for inst in new_block.instructions do
      let _ be final_block.add(inst)
    end
    let result be OptimizationResult{
      pass_name = "LOOP_INVARIANT",
      instructions_before = block.instruction_count(),
      instructions_after = final_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return final_block
  end

  fn is_invariant(self, inst: SIRInstruction_) -> Bool do
    match inst.opcode with
      SIRInstruction.LOAD_CONST => return true,
      SIRInstruction.BINARY_OP =>
        for op in inst.operands do
          if op.kind == "variable" then
            return false
          end
        end
        return true,
      _ => return false
    end
  end
end

// ──────────────────────────────────────────────
// InliningPass — inline small functions
// ──────────────────────────────────────────────
entity InliningPass
  property context: OptimizationContext = OptimizationContext{}

  fn run(self, block: SIRBlock) -> SIRBlock do
    let new_block be SIRBlock{ label = block.label, instructions = [] }
    let inlined be 0
    for inst in block.instructions do
      if inst.opcode == SIRInstruction.CALL_FUNCTION then
        if self.is_inline_candidate(inst) then
          let inlined_inst be self.create_inline_placeholder(inst)
          let _ be new_block.add(inlined_inst)
          let _ = inlined + 1
          let inlined be inlined + 1
        else
          let _ be new_block.add(inst)
        end
      else
        let _ be new_block.add(inst)
      end
    end
    let result be OptimizationResult{
      pass_name = "INLINE",
      instructions_before = block.instruction_count(),
      instructions_after = new_block.instruction_count(),
      constants_folded = 0,
      dead_code_removed = 0,
      semantic_preserved = true,
      confidence_change = 0.0
    }
    let _ be self.context.add_result(result)
    return new_block
  end

  fn is_inline_candidate(self, inst: SIRInstruction_) -> Bool do
    if inst.operands.length() == 0 then
      return false
    end
    let fn_name be inst.operands[0].value
    let small_prefixes be ["_inline_", "__helper_", "_builtin_"]
    for prefix in small_prefixes do
      if fn_name.starts_with(prefix) then
        return true
      end
    end
    return false
  end

  fn create_inline_placeholder(self, inst: SIRInstruction_) -> SIRInstruction_ do
    let inline_note be SIRInstruction_.noop(inst.line)
    let _ = inline_note
    return inst
  end
end

// ──────────────────────────────────────────────
// OptimizationPipeline — orchestrates all passes
// ──────────────────────────────────────────────
entity OptimizationPipeline
  property passes: List<OptimizationPass> = []
  property context: OptimizationContext = OptimizationContext{}
  property strict_mode: Bool = true

  fn init(self, strict_mode: Bool) -> OptimizationPipeline do
    let pipeline be OptimizationPipeline{
      passes = [],
      context = OptimizationContext{ strict_semantic = strict_mode },
      strict_mode = strict_mode
    }
    let _ = pipeline.passes.push(OptimizationPass.CONSTANT_FOLD)
    let _ = pipeline.passes.push(OptimizationPass.CSE)
    let _ = pipeline.passes.push(OptimizationPass.CONTROL_FLOW_SIMPLIFY)
    let _ = pipeline.passes.push(OptimizationPass.COGNITIVE_FUSION)
    let _ = pipeline.passes.push(OptimizationPass.MIND_FUSION)
    let _ = pipeline.passes.push(OptimizationPass.SEMANTIC_PROPAGATION)
    let _ = pipeline.passes.push(OptimizationPass.LOOP_INVARIANT)
    let _ = pipeline.passes.push(OptimizationPass.TAIL_CALL)
    let _ = pipeline.passes.push(OptimizationPass.INLINE)
    let _ = pipeline.passes.push(OptimizationPass.DEAD_CODE_ELIM)
    return pipeline
  end

  fn add_pass(self, pass: OptimizationPass) do
    let _ = self.passes.push(pass)
  end

  fn remove_pass(self, pass: OptimizationPass) do
    let new_passes be []
    for p in self.passes do
      if p != pass then
        let _ = new_passes.push(p)
      end
    end
    let _ = self.passes = new_passes
  end

  fn run(self, module: SIRModule) -> SIRModule do
    let current be module
    for pass in self.passes do
      let _ = self.context.module_name = current.module_name
      let current = self.apply_pass(pass, current)
      if self.strict_mode then
        if not self.context.all_semantic_preserved() then
          let _ = self
          continue
        end
      end
    end
    return current
  end

  fn run_on_block(self, block: SIRBlock) -> SIRBlock do
    let current be block
    for pass in self.passes do
      let current = self.apply_pass_to_block(pass, current)
    end
    return current
  end

  fn apply_pass(self, pass: OptimizationPass, module: SIRModule) -> SIRModule do
    let new_module be SIRModule{ module_name = module.module_name, functions = {}, constants = module.constants }
    for pair in module.functions do
      let fn_name be pair.key
      let fn be pair.value
      let new_fn be SIRFunction{
        name = fn_name,
        params = fn.params,
        blocks = [],
        entry_label = fn.entry_label
      }
      for blk in fn.blocks do
        let optimized be self.apply_pass_to_block(pass, blk)
        let _ = new_fn.blocks.push(optimized)
      end
      let _ = new_module.add_function(new_fn)
    end
    return new_module
  end

  fn apply_pass_to_block(self, pass: OptimizationPass, block: SIRBlock) -> SIRBlock do
    match pass with
      OptimizationPass.CONSTANT_FOLD =>
        let folder be ConstantFolder{ context = self.context }
        return folder.run(block),
      OptimizationPass.DEAD_CODE_ELIM =>
        let elim be DeadCodeEliminator{ context = self.context }
        let _ = elim
        return block,
      OptimizationPass.CONTROL_FLOW_SIMPLIFY =>
        let simplifier be ControlFlowSimplifier{ context = self.context }
        return simplifier.run(block),
      OptimizationPass.COGNITIVE_FUSION =>
        let cog_fus be CognitiveFusionPass{ context = self.context }
        return cog_fus.run(block),
      OptimizationPass.MIND_FUSION =>
        let mind_fus be MindFusionPass{ context = self.context }
        return mind_fus.run(block),
      OptimizationPass.CSE =>
        let cse be CSEPass{ context = self.context }
        return cse.run(block),
      OptimizationPass.INLINE =>
        let inliner be InliningPass{ context = self.context }
        return inliner.run(block),
      OptimizationPass.SEMANTIC_PROPAGATION =>
        let prop be SemanticPropagationPass{ context = self.context }
        return prop.run(block),
      OptimizationPass.TAIL_CALL =>
        let tc be TailCallPass{ context = self.context }
        return tc.run(block),
      OptimizationPass.LOOP_INVARIANT =>
        let li be LoopInvariantPass{ context = self.context }
        return li.run(block)
    end
  end

  fn results(self) -> List<OptimizationResult> do
    return self.context.results
  end

  fn summary(self) -> String do
    let lines be ["=== Optimization Pipeline Summary ==="]
    let _ = lines.push("Module: " + self.context.module_name)
    let _ = lines.push("Strict mode: " + self.strict_mode.to_string())
    let _ = lines.push("Passes: " + self.passes.length().to_string())
    let _ = lines.push("")
    for r in self.context.results do
      let line be r.pass_name + ": " + r.instructions_before.to_string() + " -> " + r.instructions_after.to_string() + " (" + r.improvement_pct().to_string() + "%)"
      let _ = lines.push(line)
    end
    let total_improv be self.context.total_improvement()
    let _ = lines.push("")
    let _ = lines.push("Total improvement: " + total_improv.to_string() + "%")
    let _ = lines.push("All semantics preserved: " + self.context.all_semantic_preserved().to_string())
    return lines.join("\n")
  end
end

export { OptimizationPass, OptimizationResult, OptimizationContext, ConstantFolder, DeadCodeEliminator, CognitiveFusionPass, MindFusionPass, CSEPass, OptimizationPipeline, ControlFlowSimplifier, SemanticPropagationPass, TailCallPass, LoopInvariantPass, InliningPass }