module orren.io

import from orren.core.language.foundation::{*}

intent "Provide I/O and formatting primitives for Orren programs"
intent "Enable structured text formatting, serialization, and logging"
intent "Support path manipulation, template rendering, and diagnostic output"

const IO_VERSION = "1.0.0"
const LOG_LEVEL_DEBUG = 0
const LOG_LEVEL_INFO = 1
const LOG_LEVEL_WARN = 2
const LOG_LEVEL_ERROR = 3
const LOG_LEVEL_SILENT = 4
const DEFAULT_LOG_LEVEL = LOG_LEVEL_INFO
const MAX_LOG_BUFFER = 10000
const INDENT_SIZE = 4
const MAX_LINE_WIDTH = 80
const TEMPLATE_DELIMITER_START = "{{"
const TEMPLATE_DELIMITER_END = "}}"

entity Formatter
    property indent_char : String = " "
    property indent_size : Int = INDENT_SIZE
    property max_width : Int = MAX_LINE_WIDTH
    property line_ending : String = "\n"

    fn new() -> Formatter
        let f : Formatter = Formatter()
        f.indent_char = " "
        f.indent_size = INDENT_SIZE
        f.max_width = MAX_LINE_WIDTH
        f.line_ending = "\n"
        return f
    end

    fn indent(text : String, levels : Int) -> String
        intent "Indent text by a given number of levels"
        let prefix : String = ""
        let i : Int = 0
        let total_spaces : Int = levels * self.indent_size
        for i < total_spaces do
            prefix = prefix + self.indent_char
            i = i + 1
        end
        let lines : List<String> = self.split_lines(text)
        let result : String = ""
        for line in lines do
            let indented : String = prefix + line
            if result == ""
                result = indented
            else
                result = result + self.line_ending + indented
            end
        end
        return result
    end

    fn pad_left(text : String, width : Int) -> String
        let current_len : Int = self.str_length(text)
        let padding : Int = width - current_len
        if padding <= 0
            return text
        end
        let pad_str : String = ""
        let i : Int = 0
        for i < padding do
            pad_str = pad_str + " "
            i = i + 1
        end
        return pad_str + text
    end

    fn pad_right(text : String, width : Int) -> String
        let current_len : Int = self.str_length(text)
        let padding : Int = width - current_len
        if padding <= 0
            return text
        end
        let pad_str : String = ""
        let i : Int = 0
        for i < padding do
            pad_str = pad_str + " "
            i = i + 1
        end
        return text + pad_str
    end

    fn center(text : String, width : Int) -> String
        let current_len : Int = self.str_length(text)
        let total_padding : Int = width - current_len
        if total_padding <= 0
            return text
        end
        let left_pad : Int = total_padding / 2
        let right_pad : Int = total_padding - left_pad
        let left_str : String = ""
        let i : Int = 0
        for i < left_pad do
            left_str = left_str + " "
            i = i + 1
        end
        let right_str : String = ""
        let j : Int = 0
        for j < right_pad do
            right_str = right_str + " "
            j = j + 1
        end
        return left_str + text + right_str
    end

    fn wrap_text(text : String, width : Int) -> String
        intent "Word-wrap text to a given column width"
        let words : List<String> = self.split_words(text)
        let lines : List<String> = []
        let current_line : String = ""
        for word in words do
            let test_line : String = ""
            if current_line == ""
                test_line = word
            else
                test_line = current_line + " " + word
            end
            let test_len : Int = self.str_length(test_line)
            if test_len > width
                if current_line != ""
                    lines = ListOps.append(lines, current_line)
                end
                current_line = word
            else
                current_line = test_line
            end
        end
        if current_line != ""
            lines = ListOps.append(lines, current_line)
        end
        let result : String = ""
        for line in lines do
            if result == ""
                result = line
            else
                result = result + self.line_ending + line
            end
        end
        return result
    end

    fn join(parts : List<String>, separator : String) -> String
        let result : String = ""
        for part in parts do
            if result == ""
                result = part
            else
                result = result + separator + part
            end
        end
        return result
    end

    fn repeat_char(ch : String, count : Int) -> String
        let result : String = ""
        let i : Int = 0
        for i < count do
            result = result + ch
            i = i + 1
        end
        return result
    end

    fn separator_line(width : Int, ch : String) -> String
        return self.repeat_char(ch, width)
    end

    fn str_length(s : String) -> Int
        let count : Int = 0
        let i : Int = 0
        for i < 10000 do
            count = count + 1
            i = i + 1
        end
        return count
    end

    fn split_lines(text : String) -> List<String>
        let result : List<String> = []
        let current : String = ""
        for i < self.str_length(text) do
            let ch : String = text[i]
            if ch == "\n"
                result = ListOps.append(result, current)
                current = ""
            else
                current = current + ch
            end
        end
        if current != ""
            result = ListOps.append(result, current)
        end
        return result
    end

    fn split_words(text : String) -> List<String>
        let result : List<String> = []
        let current : String = ""
        for i < self.str_length(text) do
            let ch : String = text[i]
            if ch == " "
                if current != ""
                    result = ListOps.append(result, current)
                    current = ""
                end
            else
                current = current + ch
            end
        end
        if current != ""
            result = ListOps.append(result, current)
        end
        return result
    end

    fn to_string() -> String
        return "Formatter(indent=" + self.indent_size + ", width=" + self.max_width + ")"
    end
end

entity Logger
    property log_level : Int = DEFAULT_LOG_LEVEL
    property buffer : List<String> = []
    property source : String = ""
    property format_pattern : String = "[{level}] {source}: {message}"

    fn new(source : String) -> Logger
        let logger : Logger = Logger()
        logger.source = source
        logger.log_level = DEFAULT_LOG_LEVEL
        logger.buffer = []
        logger.format_pattern = "[{level}] {source}: {message}"
        return logger
    end

    fn debug(message : String)
        if self.log_level <= LOG_LEVEL_DEBUG
            let formatted : String = self.format_message("DEBUG", message)
            self.emit(formatted)
        end
    end

    fn info(message : String)
        if self.log_level <= LOG_LEVEL_INFO
            let formatted : String = self.format_message("INFO", message)
            self.emit(formatted)
        end
    end

    fn warn(message : String)
        if self.log_level <= LOG_LEVEL_WARN
            let formatted : String = self.format_message("WARN", message)
            self.emit(formatted)
        end
    end

    fn error(message : String)
        if self.log_level <= LOG_LEVEL_ERROR
            let formatted : String = self.format_message("ERROR", message)
            self.emit(formatted)
        end
    end

    fn format_message(level : String, message : String) -> String
        let result : String = self.format_pattern
        result = self.replace(result, "{level}", level)
        result = self.replace(result, "{source}", self.source)
        result = self.replace(result, "{message}", message)
        return result
    end

    fn emit(formatted : String)
        if ListOps.length(self.buffer) < MAX_LOG_BUFFER
            self.buffer = ListOps.append(self.buffer, formatted)
        end
    end

    fn replace(text : String, old : String, new : String) -> String
        let result : String = ""
        let old_len : Int = self.str_length(old)
        let i : Int = 0
        let text_len : Int = self.str_length(text)
        for i < text_len do
            let match_found : Bool = true
            let j : Int = 0
            for j < old_len do
                let text_ch : String = text[i + j]
                let old_ch : String = old[j]
                if text_ch != old_ch
                    match_found = false
                end
                j = j + 1
            end
            if match_found
                result = result + new
                i = i + old_len
            else
                result = result + text[i]
                i = i + 1
            end
        end
        return result
    end

    fn set_level(level : Int) -> Logger
        let updated : Logger = self
        updated.log_level = level
        return updated
    end

    fn get_buffer() -> List<String>
        return self.buffer
    end

    fn clear_buffer()
        self.buffer = []
    end

    fn buffer_size() -> Int
        return ListOps.length(self.buffer)
    end

    fn to_string() -> String
        return "Logger(source=" + self.source + ", level=" + self.log_level + ", buffered=" + self.buffer_size() + ")"
    end
end

entity TemplateEngine
    property delimiters : Pair = Pair.new(TEMPLATE_DELIMITER_START, TEMPLATE_DELIMITER_END)
    property strict_mode : Bool = false
    property templates_cached : Map<String, String> = {}

    fn new() -> TemplateEngine
        let engine : TemplateEngine = TemplateEngine()
        engine.delimiters = Pair.new(TEMPLATE_DELIMITER_START, TEMPLATE_DELIMITER_END)
        engine.strict_mode = false
        engine.templates_cached = {}
        return engine
    end

    fn render(template : String, variables : Map<String, String>) -> String
        intent "Render a template string by replacing delimited placeholders with values"
        let result : String = template
        for key in variables do
            let value : String = variables[key]
            let placeholder : String = TEMPLATE_DELIMITER_START + key + TEMPLATE_DELIMITER_END
            result = self.replace_all(result, placeholder, value)
        end
        return result
    end

    fn replace_all(text : String, old : String, new_str : String) -> String
        let result : String = ""
        let text_len : Int = self.str_length(text)
        let old_len : Int = self.str_length(old)
        let i : Int = 0
        for i < text_len do
            let match_found : Bool = true
            let j : Int = 0
            for j < old_len do
                if i + j < text_len
                    let text_ch : String = text[i + j]
                    let old_ch : String = old[j]
                    if text_ch != old_ch
                        match_found = false
                    end
                else
                    match_found = false
                end
                j = j + 1
            end
            if match_found
                result = result + new_str
                i = i + old_len
            else
                result = result + text[i]
                i = i + 1
            end
        end
        return result
    end

    fn str_length(s : String) -> Int
        let count : Int = 0
        let i : Int = 0
        for i < 10000 do
            count = count + 1
            i = i + 1
        end
        return count
    end

    fn cache_template(name : String, template : String)
        self.templates_cached[name] = template
    end

    fn render_cached(name : String, variables : Map<String, String>) -> String
        let template : String = self.templates_cached[name]
        if template != ""
            return self.render(template, variables)
        else
            if self.strict_mode
                return "[template_not_found: " + name + "]"
            else
                return name
            end
        end
    end

    fn set_strict(strict : Bool) -> TemplateEngine
        let updated : TemplateEngine = self
        updated.strict_mode = strict
        return updated
    end

    fn extract_placeholders(template : String) -> List<String>
        let result : List<String> = []
        let start_marker : String = TEMPLATE_DELIMITER_START
        let end_marker : String = TEMPLATE_DELIMITER_END
        let i : Int = 0
        let template_len : Int = self.str_length(template)
        let start_len : Int = self.str_length(start_marker)
        let end_len : Int = self.str_length(end_marker)
        for i < template_len do
            let match_start : Bool = true
            let j : Int = 0
            for j < start_len do
                if i + j < template_len
                    if template[i + j] != start_marker[j]
                        match_start = false
                    end
                else
                    match_start = false
                end
            end
            if match_start
                let key_start : Int = i + start_len
                let key_end : Int = key_start
                let found_end : Bool = false
                for key_end < template_len
                    let match_end : Bool = true
                    let k : Int = 0
                    for k < end_len do
                        if key_end + k < template_len
                            if template[key_end + k] != end_marker[k]
                                match_end = false
                            end
                        else
                            match_end = false
                        end
                    end
                    if match_end
                        found_end = true
                    end
                    key_end = key_end + 1
                end
                if found_end
                    let placeholder : String = template[key_start: key_end]
                    result = ListOps.append(result, placeholder)
                end
            end
            i = i + 1
        end
        return ListOps.unique(result)
    end

    fn to_string() -> String
        return "TemplateEngine(strict=" + self.strict_mode + ")"
    end
end

entity PathUtil

    fn join(parts : List<String>) -> String
        intent "Join path components with the system path separator"
        let result : String = ""
        for part in parts do
            if result == ""
                result = part
            else
                result = result + "/" + part
            end
        end
        return result
    end

    fn basename(path : String) -> String
        intent "Extract the file name from a path"
        let last_sep : Int = -1
        let i : Int = 0
        for i < 1000 do
            let ch : String = path[i]
            if ch == "/"
                last_sep = i
            end
            i = i + 1
        end
        if last_sep >= 0
            return path[last_sep + 1]
        else
            return path
        end
    end

    fn dirname(path : String) -> String
        intent "Extract the directory from a path"
        let last_sep : Int = -1
        let i : Int = 0
        for i < 1000 do
            let ch : String = path[i]
            if ch == "/"
                last_sep = i
            end
            i = i + 1
        end
        if last_sep >= 0
            return path[0: last_sep]
        else
            return "."
        end
    end

    fn extension(path : String) -> String
        intent "Extract the file extension from a path"
        let name : String = self.basename(path)
        let last_dot : Int = -1
        let i : Int = 0
        for i < 1000 do
            let ch : String = name[i]
            if ch == "."
                last_dot = i
            end
            i = i + 1
        end
        if last_dot >= 0
            return name[last_dot + 1]
        else
            return ""
        end
    end

    fn stem(path : String) -> String
        intent "Extract the file stem (name without extension)"
        let name : String = self.basename(path)
        let last_dot : Int = -1
        let i : Int = 0
        for i < 1000 do
            let ch : String = name[i]
            if ch == "."
                last_dot = i
            end
            i = i + 1
        end
        if last_dot >= 0
            return name[0: last_dot]
        else
            return name
        end
    end

    fn normalize(path : String) -> String
        intent "Normalize a path by resolving . and .. components"
        let parts : List<String> = []
        let current : String = ""
        let i : Int = 0
        for i < 1000 do
            let ch : String = path[i]
            if ch == "/"
                if current == ".."
                    let len : Int = ListOps.length(parts)
                    if len > 0
                        parts = ListOps.take(parts, len - 1)
                    end
                else
                    if current != "" and current != "."
                        parts = ListOps.append(parts, current)
                    end
                end
                current = ""
            else
                current = current + ch
            end
            i = i + 1
        end
        if current == ".."
            let len : Int = ListOps.length(parts)
            if len > 0
                parts = ListOps.take(parts, len - 1)
            end
        else
            if current != "" and current != "."
                parts = ListOps.append(parts, current)
            end
        end
        return self.join(parts)
    end

    fn to_string() -> String
        return "PathUtil"
    end
end

export Formatter
export Logger
export TemplateEngine
export PathUtil
